{
  "description": "GlympFoto — private photo sharing server for Android/Termux",
  "license": "MIT",
  "name": "glympfoto",
  "private": true,
  "scripts": {
    "build": "tsc",
    "cleanup": "tsx scripts/cleanup.ts",
    "db:init": "tsx scripts/init-db.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "install": "bash scripts/install.sh",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "start:all": "bash scripts/start-all.sh",
    "stop": "bash scripts/stop.sh",
    "status": "bash scripts/status.sh",
    "logs": "tail -f logs/server.log logs/funnel.log",
    "test": "vitest run"
  },
  "type": "module",
  "version": "1.0.0",
  "dependencies": {
    "@img/sharp-wasm32": "^0.34.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsdom": "^30.1.0",
    "multer": "^1.4.5-lts.2",
    "pureimage": "^0.4.20",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true
  }
}
