# Copy ke .env dan isi nilainya (atau biarkan scripts/install.sh yang buatkan)
# cp .env.example .env
PORT=3000
# Token admin — dibuatkan otomatis oleh install.sh (openssl rand -hex 32).
# Jangan pakai nilai default ini di production.
ADMIN_TOKEN=ganti-dengan-token-acak-panjang
# Direktori data & storage. STORAGE_DIR bisa menunjuk memori bersama
# (mis. /sdcard/GlympFoto) agar foto langsung terlihat di file manager/
# galeri — wajib termux-setup-storage dulu. Foto disimpan dengan nama asli.
DATA_DIR=./data
STORAGE_DIR=./storage
DB_PATH=./data/glympfoto.db
# Batas upload dalam MB
MAX_UPLOAD_MB=15
# Retensi audit log dalam hari (0 = simpan selamanya, default 90)
AUDIT_RETENTION_DAYS=90
# Mode guest upload tanpa token (0=mati, 1=nyala). Nyala = siapa saja bisa upload.
GUEST_UPLOAD=0
# Password admin (login dashboard). Kalau kosong, pakai ADMIN_TOKEN.
# ADMIN_PASSWORD=kata-sandi-kuat
# Domain publik pembungkus (mis. GitHub Pages) yang boleh meng-iframe viewer.
# Kosong = tidak ada pihak luar yang boleh embed.
# PUBLIC_HOST=
